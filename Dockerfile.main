# =============================================================
#  Navi 镜像 - main(可选浏览器渲染抓取)
#
#  含 Playwright + Chromium,用于 NAVI_BROWSER=local 的浏览器抓取。
#  注意:不设 NAVI_BROWSER=local 时,Chromium 只是躺在镜像里不运行;
#        低配机器建议用 Dockerfile.lite(无浏览器,约 150MB)。
#
#  历史教训:此镜像早期版本硬编码 NAVI_BROWSER_CDP=ws://browser:3000,
#  连接不存在的浏览器容器时会每个请求泄漏一个 Playwright driver 进程,
#  数十次即吃满宿主机内存。现已改为显式开关 + 失败即回收。
# =============================================================
FROM python:3.13-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt playwright \
    && playwright install --with-deps chromium

COPY app ./app
COPY static ./static

ENV MOOLO_NAV_DB=/data/nav.db \
    MOOLO_NAV_CACHE=/data/favicons \
    NAVI_BROWSER=off

VOLUME /data
EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
