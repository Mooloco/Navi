# Navi Docker 部署配置
# 复制为 .env 后按需修改

# 镜像变体:lite(默认,无浏览器,约 150MB)/ main(含 Chromium,约 1.5GB)
NAVI_BRANCH=lite

# 浏览器抓取开关:off(默认,仅 httpx 静态抓取)/ local(进程内 Chromium)/ cdp(外部浏览器容器)
# 默认 off —— 图标抓取绝大多数站点靠 httpx 静态解析就够,零额外内存。
# 需要浏览器渲染时才改,且要求 NAVI_BRANCH=main。
NAVI_BROWSER=off

# 对外访问端口
NAVI_PORT=8000

# 数据目录(宿主机文件夹,存放 SQLite 数据库 + 图标缓存)
# 默认 ./data(相对 compose 文件所在目录)
NAVI_DATA=./data

# 应用容器内存上限(防止异常时拖垮宿主机)
NAVI_MEM_LIMIT=768m
